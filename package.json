{
  "name": "apigestion-api",
  "version": "1.0.0",
  "description": "API Backend para ApiGestión Pro - Plataforma de Gestión Apícola",
  "main": "dist/server.js",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "build": "bun build ./src/server.ts --outfile ./dist/server.js --target bun",
    "start": "bun dist/server.js",
    "test": "bun test",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run db/seed.ts",
    "lint": "eslint src/**/*.ts",
    "db:seed:demo": "bun run db/seed-demo.ts"
  },
  "keywords": [
    "apicultura",
    "api",
    "typescript",
    "elysia",
    "colmenas"
  ],
  "author": "ApiGestión Pro",
  "license": "MIT",
  "overrides": {
    "elysia": "2.0.0-beta.32",
    "@grpc/grpc-js": "1.14.4",
    "fast-xml-parser": "4.5.5",
    "form-data": "4.0.6",
    "jws": "4.0.1",
    "lodash": "4.18.0",
    "node-forge": "1.4.0",
    "protobufjs": "7.6.1",
    "validator": "13.15.22",
    "defu": "6.1.5",
    "effect": "3.20.0"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.0",
    "@johpaz/hive-sdk": "^0.7.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@sinclair/typebox": "^0.34.41",
    "@types/bun": "1.3.1",
    "elysia": "2.0.0-beta.32",
    "express-validator": "7.3.0",
    "firebase-admin": "13.6.0",
    "jsonwebtoken": "9.0.2",
    "pino": "10.1.0",
    "pino-pretty": "13.1.2",
    "resend": "6.4.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.10.0",
    "@typescript-eslint/eslint-plugin": "8.46.3",
    "@typescript-eslint/parser": "8.46.3",
    "eslint": "9.39.1",
    "jest": "30.2.0",
    "ts-node": "10.9.2",
    "typescript": "^5.9.3"
  }
}
