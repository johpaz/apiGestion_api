# Server Configuration
PORT=3001
NODE_ENV=development

# Base de datos (contenedor Postgres de docker-compose)
# Desarrollo local: docker compose -f docker-compose.local.yml up -d db  (puerto 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/apicolmena

# Solo producción (docker-compose.yml). Usa una contraseña sin caracteres especiales de URL (@ : / ? # *)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=apicolmena

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# CORS Configuration - Supports multiple origins separated by commas
# Example: CORS_ORIGIN=http://localhost:5173,https://apicolmena.vercel.app
CORS_ORIGIN=http://localhost:5173

# URLs
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Docker/Traefik Domain (for production)
APICOLMENA_DOMAIN=api.apicolmena.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API Configuration
API_VERSION=v1

# Firebase (login con Google)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_X509_CERT_URL=
GOOGLE_CLIENT_ID=

# Administrador inicial (se crea solo en el primer arranque; en producción la contraseña es obligatoria)
SUPER_ADMIN_EMAIL=admin@apicolmena.com
SUPER_ADMIN_PASSWORD=cambia-esta-contrasena
ADMIN_NAME=Administrador

# Logs
LOG_LEVEL=info

# Resend Configuration
RESEND_API_KEY=your-resend-api-key-here

# Currency Exchange Rates
USD_TO_COP_RATE=4000
EUR_TO_USD_RATE=1.05
EUR_TO_COP_RATE=4200

# ─── Asistente de IA (Hive SDK + Gemini) ─────────────────────────────────────
# Cada apicultor guarda SU API key de Gemini desde la app (se cifra en HiveDB); el modelo es gemini-3.8-flash.
# Directorio de HiveDB (agentes, conversaciones y claves cifradas). En producción debe ser un volumen persistente.
HIVE_HOME=./data/hive
# Secreto con el que se cifran las API keys de IA en Postgres (32+ caracteres aleatorios). Si se omite se usa JWT_SECRET.
# NO lo cambies después: las claves guardadas dejarían de poder leerse.
AI_KEY_SECRET=
# (HiveDB) Clave maestra del SDK; ya no guarda las API keys de los usuarios (32+ caracteres aleatorios; solo cuentan los primeros 32).
# Si se omite se genera HIVE_HOME/.master.key. Si la cambias, las API keys guardadas dejan de poder leerse.
HIVE_MASTER_KEY=
# Opcional: clave de Gemini de la PLATAFORMA, usada solo por administradores que no hayan guardado la suya
GEMINI_API_KEY=
# Opcional: cambia el modelo (debe existir en el catálogo del SDK)
AI_MODEL=gemini-3.8-flash
